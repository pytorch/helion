def helion_flex_attention_backward_kernel(query: torch.Tensor, key: torch.Tensor, value: torch.Tensor, grad_out: torch.Tensor, lse2: torch.Tensor, delta: torch.Tensor, score_mod: Callable, score_mod_bwd: Callable, block_mask_q_num_blocks: torch.Tensor, block_mask_q_indices: torch.Tensor, block_mask_full_q_num_blocks: torch.Tensor, block_mask_full_q_indices: torch.Tensor, block_mask_mask_mod: Callable, block_mask_m: int, block_mask_n: int, scale: float, enable_gqa: bool=False, *, _launcher=_default_cute_launcher):
