    tKsK, tKgK_kdl = cute_cpasync_flash.tma_partition(_flash_tma_k, 0, cute.make_layout(1), cute.group_modes(sK, 0, 3), cute.group_modes(tSgK, 0, 3))
    tQgQ = tQgQ_qdl[None, None, 0, flash_bh]
    tKgK = tKgK_kdl[None, None, 0, flash_bh]
