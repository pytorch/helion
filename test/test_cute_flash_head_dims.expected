def helion_flex_attention_kernel(query: torch.Tensor, key: torch.Tensor, value: torch.Tensor, score_mod: Callable, block_mask_kv_num_blocks: torch.Tensor, block_mask_kv_indices: torch.Tensor, block_mask_full_kv_num_blocks: torch.Tensor | None, block_mask_full_kv_indices: torch.Tensor | None, block_mask_mask_mod: Callable, block_mask_m: int, block_mask_n: int, scale: float, enable_gqa: bool=False, *, _launcher=_default_cute_launcher):
    # src[flex_attention.py:N]: B, H, M, D = query.size()
    B, H, M, D = query.size()
    # src[flex_attention.py:N]: D = hl.specialize(D)
    D = 256
    # src[flex_attention.py:N]: Dv = hl.specialize(value.size(-1))
    Dv = 256
    # src[flex_attention.py:N]: Bk, Hk, N, Dk = key.size()
    Bk, Hk, N, Dk = key.size()
    # src[flex_attention.py:N]: assert Bk == B
    assert Bk == B
    # src[flex_attention.py:N]: assert Dk == D
    assert Dk == D
    # src[flex_attention.py:N]: assert value.size()[:3] == key.size()[:3]
    assert value.size()[:3] == key.size()[:3]
    # src[flex_attention.py:N]: if enable_gqa:
    # src[flex_attention.py:N]:     assert H % Hk == 0
    # src[flex_attention.py:N]: else:
    # src[flex_attention.py:N-N]: ...
    if enable_gqa:
        # src[flex_attention.py:N]: assert H % Hk == 0
        assert H % Hk == 0
    else:
        # src[flex_attention.py:N]: assert Hk == H
        assert Hk == H
    # src[flex_attention.py:N]: table_batch, table_heads, _ = block_mask_kv_num_blocks.size()
    table_batch, table_heads, _ = block_mask_kv_num_blocks.size()
    # src[flex_attention.py:N]: if Dv == D:
    # src[flex_attention.py:N]:     out = torch.empty_like(query)
    # src[flex_attention.py:N]: else:
    # src[flex_attention.py:N-N]: ...
    if Dv == D:
        # src[flex_attention.py:N]: out = torch.empty_like(query)
        out = torch.empty_like(query)
    else:
        # src[flex_attention.py:N]: out = torch.empty((B, H, M, Dv), dtype=query.dtype, device=query.device)
        out = torch.empty((B, H, M, Dv), dtype=query.dtype, device=query.device)
    # src[flex_attention.py:N]: lse = torch.empty((B, H, M), dtype=torch.float32, device=out.device)
    lse = torch.empty((B, H, M), dtype=torch.float32, device=out.device)
    # src[flex_attention.py:N]: assert (block_mask_full_kv_indices is None) == (
    # src[flex_attention.py:N]:     block_mask_full_kv_num_blocks is None
    # src[flex_attention.py:N]: )
    assert (block_mask_full_kv_indices is None) == (block_mask_full_kv_num_blocks is None)
    # src[flex_attention.py:N]: for tile_b, tile_h, tile_m in hl.tile([B, H, M], block_size=[1, 1, block_m]):
    # src[flex_attention.py:N]:     m_i = hl.full([tile_m], float("-inf"), dtype=torch.float32)
    # src[flex_attention.py:N]:     l_i = torch.full_like(m_i, 1.0)
    # src[flex_attention.py:N-N]: ...
    _launcher(_helion_helion_flex_attention_kernel, (64,), query, key, value, out, block_mask_kv_num_blocks, block_mask_kv_indices, block_mask_full_kv_num_blocks, block_mask_full_kv_indices, lse, _helion_flash_flex_item_table(block_mask_kv_num_blocks, block_mask_kv_indices, block_mask_full_kv_num_blocks, block_mask_full_kv_indices, q_block=128, batch=2, heads=4, num_pairs=4, num_kv=8, group=8), _helion_flash_flex_item_words(block_mask_kv_num_blocks, block_mask_kv_indices, block_mask_full_kv_num_blocks, block_mask_full_kv_indices, q_block=128, batch=2, heads=4, num_pairs=4, num_kv=8), scale, block=(256, 1, 1))
    # src[flex_attention.py:N]: return out, lse
    return (out, lse)

