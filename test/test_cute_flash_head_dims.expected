    flash_m_tile = flash_q_mma_tile * 2 + flash_mma_tile_coord_v
    flash_m_tile_hi = flash_m_tile | cutlass.Int32(1)
    flash_m_pair = flash_q_mma_tile
    flash_m_tile0 = flash_q_mma_tile * 2
    flash_m_tile1 = flash_m_tile0 + cutlass.Int32(1)
    _flash_mFlexWords = flash_flex_words
    _flash_heads = 4
    flash_flex_b = flash_bh // _flash_heads
    flash_flex_h = flash_bh % _flash_heads
    flash_flex_wrow = (flash_bh * cutlass.Int32(4) + flash_m_pair) * cutlass.Int32(4)
    flash_flex_p0_0 = cutlass.Int32(_flash_mFlexWords[flash_flex_wrow + cutlass.Int32(0)])
    flash_flex_f0_0 = cutlass.Int32(_flash_mFlexWords[flash_flex_wrow + cutlass.Int32(1)])
    flash_flex_p1_0 = cutlass.Int32(_flash_mFlexWords[flash_flex_wrow + cutlass.Int32(2)])
    flash_flex_f1_0 = cutlass.Int32(_flash_mFlexWords[flash_flex_wrow + cutlass.Int32(3)])
    flash_flex_u0 = flash_flex_p0_0 | flash_flex_f0_0 | flash_flex_p1_0 | flash_flex_f1_0
    flash_num_active_kv = cutlass.max(cutlass.Int32(1), cutlass.Int32(cute.arch.popc(flash_flex_u0)))
    flash_flex_pm_0 = cutlass.Int32(cutlass.select_(flash_mma_tile_coord_v == 0, flash_flex_p0_0, flash_flex_p1_0))
    flash_flex_fm_0 = cutlass.Int32(cutlass.select_(flash_mma_tile_coord_v == 0, flash_flex_f0_0, flash_flex_f1_0))
    flash_active_count = flash_num_active_kv
