    flash_mma_o_prod, flash_mma_o_cons = cutlass_pipeline_flash.PipelineUmmaAsync.create(num_stages=1, producer_group=cutlass_pipeline_flash.CooperativeGroup(cutlass_pipeline_flash.Agent.Thread), consumer_group=cutlass_pipeline_flash.CooperativeGroup(cutlass_pipeline_flash.Agent.Thread, 128), barrier_storage=storage.mma_o_mbar_ptr.data_ptr(), defer_sync=True).make_participants()
    flash_p_ready_prod, flash_p_ready_cons = cutlass_pipeline_flash.PipelineAsync.create(num_stages=2, producer_group=cutlass_pipeline_flash.CooperativeGroup(cutlass_pipeline_flash.Agent.Thread, 128), consumer_group=cutlass_pipeline_flash.CooperativeGroup(cutlass_pipeline_flash.Agent.Thread, 32), barrier_storage=storage.p_ready_mbar_ptr.data_ptr(), defer_sync=True).make_participants()
    cute.arch.mbarrier_init_fence()
    flash_tmem.wait_for_alloc()
    flash_tmem_ptr = flash_tmem.retrieve_ptr(cutlass.Float32)
    flash_s_layout = tStS.layout
    tStS0 = cute.make_tensor(flash_tmem_ptr, flash_s_layout)
    tStS1 = cute.make_tensor(flash_tmem_ptr + 128, flash_s_layout)
