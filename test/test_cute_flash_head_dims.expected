# src[test_cute_flash_head_dims.py:N-N]: ...
_helion__dense_attention._helion_cute_wrapper_plans = [{'kind': 'helion_flash', 'seq': 2048, 'head_dim': 256, 'dtype': 'cutlass.BFloat16', 'batch': 8, 'scale_log2': 0.09016844005556021, 'kv_stage': 2, 'kv_tile_n': 128, 's_stage': 2, 'persistent': False, 'persistent_ctas_per_sm': 1, 'total_tiles': 64, 'pair_cluster': 1, 'topology': 'ws_overlap', 'q_stage': 1, 'q_tile_m': 128, 'ws_one_pass': False, 'epi_tma': False, 'epi_stg': False, 'use_2cta_instrs': True, 'use_cga2_local_cta': False, 'use_clc_scheduler': False, 'clc_heads_per_batch': 0, 'local_tma_partition': False, 'q_idx': 0, 'k_idx': 1, 'v_idx': 2, 'o_idx': 3}]
_helion__dense_attention._helion_cute_cluster_shape = (2, 1, 1)

def _dense_attention(q_in: torch.Tensor, k_in: torch.Tensor, v_in: torch.Tensor, *, _launcher=_default_cute_launcher):
    # src[test_cute_flash_head_dims.py:N]: m_dim = q_in.size(-2)
    m_dim = q_in.size(-2)
    # src[test_cute_flash_head_dims.py:N]: n_dim = k_in.size(-2)
    n_dim = k_in.size(-2)
    # src[test_cute_flash_head_dims.py:N]: head_dim = hl.specialize(q_in.size(-1))
    head_dim = 256
    # src[test_cute_flash_head_dims.py:N]: q_view = q_in.reshape([-1, m_dim, head_dim])
    q_view = q_in.reshape([-1, m_dim, head_dim])
    # src[test_cute_flash_head_dims.py:N]: k_view = k_in.reshape([-1, n_dim, head_dim])
    k_view = k_in.reshape([-1, n_dim, head_dim])
    # src[test_cute_flash_head_dims.py:N]: v_view = v_in.reshape([-1, n_dim, head_dim])
    v_view = v_in.reshape([-1, n_dim, head_dim])
    # src[test_cute_flash_head_dims.py:N]: out = torch.empty_like(q_view)
    out = torch.empty_like(q_view)
    # src[test_cute_flash_head_dims.py:N]: qk_scale = (1.0 / math.sqrt(head_dim)) * math.log2(math.e)
    qk_scale = 1.0 / math.sqrt(head_dim) * math.log2(math.e)
    # src[test_cute_flash_head_dims.py:N]: for tile_b, tile_m in hl.tile([q_view.size(0), m_dim]):
    # src[test_cute_flash_head_dims.py:N]:     m_i = hl.full([tile_b, tile_m], float("-inf"), dtype=torch.float32)
    # src[test_cute_flash_head_dims.py:N]:     l_i = torch.full_like(m_i, 1.0)
    # src[test_cute_flash_head_dims.py:N-N]: ...
    _launcher(_helion__dense_attention, (128,), q_view, k_view, v_view, out, block=(256, 1, 1))
    # src[test_cute_flash_head_dims.py:N]: return out.view(q_in.size())
    return out.view(q_in.size())

