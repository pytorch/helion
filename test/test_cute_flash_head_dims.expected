                _helion_flash_rt.named_barrier_wait_unaligned(7 + warp_idx % 4, 64)
                flash_a1 = flash_scale_t[flash_s_corr_cons_index, 1, flash_local_tidx]
                cute.arch.mbarrier_arrive(flash_s1_corr_empty_ptr + flash_s_corr_cons_index)
                flash_need_rescale1 = cute.arch.vote_ballot_sync(flash_a1 < 1.0) != 0
                if flash_need_rescale1:
                    _helion_flash_rt.rescale_o_tmem(tOtO1, flash_a1, flash_local_tidx, 64, 32)
                    cute.arch.fence_view_async_tmem_store()
                _helion_flash_rt.mbarrier_arrive(flash_pfor_ptr + 1)
                flash_s_corr_cons_index ^= 1
            _helion_flash_rt.named_barrier_wait_unaligned(3 + warp_idx % 4, 64)
            flash_inv_sum0 = _helion_flash_rt.rcp_approx_ftz_or_zero(flash_scale_t[flash_s_corr_cons_index, 0, flash_local_tidx])
            cute.arch.mbarrier_arrive(flash_s0_corr_empty_ptr + flash_s_corr_cons_index)
            _helion_flash_rt.mbar_spin_wait(flash_o_full_ptr + 0, flash_o_full_phase, 10000000)
            _helion_flash_rt.mbar_spin_wait(flash_corr_epi_empty_ptr + 0, flash_corr_epi_empty_phase, 10000000)
            _helion_flash_rt.fa4_correction_epilogue_to_smem_scoped(flash_pvt, tOtO0, sO[None, None, 0], flash_local_tidx, flash_inv_sum0, 64, 8, cutlass.BFloat16)
            cute.arch.fence_view_async_shared()
            cute.arch.mbarrier_arrive(flash_corr_epi_full_ptr + 0)
            _helion_flash_rt.mbarrier_arrive(flash_pfor_ptr + 0)
            _helion_flash_rt.named_barrier_wait_unaligned(7 + warp_idx % 4, 64)
            flash_inv_sum1 = _helion_flash_rt.rcp_approx_ftz_or_zero(flash_scale_t[flash_s_corr_cons_index, 1, flash_local_tidx])
            cute.arch.mbarrier_arrive(flash_s1_corr_empty_ptr + flash_s_corr_cons_index)
            _helion_flash_rt.mbar_spin_wait(flash_o_full_ptr + 1, flash_o_full_phase, 10000000)
            _helion_flash_rt.mbar_spin_wait(flash_corr_epi_empty_ptr + 1, flash_corr_epi_empty_phase, 10000000)
            _helion_flash_rt.fa4_correction_epilogue_to_smem_scoped(flash_pvt, tOtO1, sO[None, None, 1], flash_local_tidx, flash_inv_sum1, 64, 8, cutlass.BFloat16)
            cute.arch.fence_view_async_shared()
            cute.arch.mbarrier_arrive(flash_corr_epi_full_ptr + 1)
            _helion_flash_rt.mbarrier_arrive(flash_pfor_ptr + 1)
            flash_corr_epi_empty_phase ^= 1
            flash_s_corr_cons_index ^= 1
            flash_o_full_phase ^= 1
            flash_tile_id = flash_tile_id + flash_grid_dim
        _helion_flash_rt.named_barrier_arrive_unaligned(2, 13 * 32)
# src[flex_attention.py:N]: def helion_flex_attention_kernel(
# src[flex_attention.py:N]:     query: torch.Tensor,
