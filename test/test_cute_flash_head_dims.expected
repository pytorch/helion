    # src[flex_attention.py:N]:     out = torch.empty_like(query)
    # src[flex_attention.py:N]: else:
    # src[flex_attention.py:N-N]: ...
    if Dv == D:
        # src[flex_attention.py:N]: out = torch.empty_like(query)
        out = torch.empty_like(query)
    else:
        # src[flex_attention.py:N]: out = torch.empty((B, H, M, Dv), dtype=query.dtype, device=query.device)
        out = torch.empty((B, H, M, Dv), dtype=query.dtype, device=query.device)
