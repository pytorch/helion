    _launcher(_helion_helion_flex_attention_kernel, (64,), query, key, value, out, block_mask_kv_num_blocks, block_mask_kv_indices, block_mask_full_kv_num_blocks, block_mask_full_kv_indices, lse, _helion_flash_flex_item_table(block_mask_kv_num_blocks, block_mask_kv_indices, block_mask_full_kv_num_blocks, block_mask_full_kv_indices, q_block=128, batch=2, heads=4, num_pairs=4, num_kv=8), _helion_flash_flex_item_words(block_mask_kv_num_blocks, block_mask_kv_indices, block_mask_full_kv_num_blocks, block_mask_full_kv_indices, q_block=128, batch=2, heads=4, num_pairs=4, num_kv=8), scale, block=(512, 1, 1))
