                flash_k_full = flash_k_cons.wait_and_advance()
                flash_s_handle = flash_mma_s_prod.acquire_and_advance()
                if flash_qk_idx % 2 == 0:
                    for flash_kp in cutlass.range(flash_nk, unroll_full=True):
                        _flash_qk_mma.set(cute_tcgen05_flash.Field.ACCUMULATE, flash_kp != 0)
                        cute.gemm(_flash_qk_mma, tStS0, tSrQ[None, None, flash_kp, flash_q_full.index], tSrK[None, None, flash_kp, flash_k_full.index], tStS0)
                else:
                    for flash_kp in cutlass.range(flash_nk, unroll_full=True):
                        _flash_qk_mma.set(cute_tcgen05_flash.Field.ACCUMULATE, flash_kp != 0)
                        cute.gemm(_flash_qk_mma, tStS1, tSrQ[None, None, flash_kp, flash_q_full.index], tSrK[None, None, flash_kp, flash_k_full.index], tStS1)
